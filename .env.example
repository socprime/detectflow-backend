# DetectFlow Backend Configuration

# ==========================================
# LOGGING
# ==========================================
LOG_LEVEL=INFO

# ==========================================
# API DOCUMENTATION
# ==========================================
# Swagger UI (/docs), ReDoc (/redoc) and OpenAPI JSON (/openapi.json) are off by default.
# Set to false to serve them, e.g. for local development.
DISABLE_API_DOCS=true

# ==========================================
# CORS
# ==========================================
# Comma-separated browser origins allowed to call the API cross-origin
# ("scheme://host[:port]", no trailing slash). Default empty = same-origin only, which is
# correct whenever the frontend calls the API on its own host (e.g. a reverse proxy exposing
# the API under /api on the frontend host) — then CORS is not involved at all.
# Set this only when the frontend is served from a different origin than the API, e.g. local
# dev with the frontend on its own dev-server port:
# CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173
# "*" is not supported: auth cookies make requests credentialed, and a wildcard origin
# would let any site the user visits act on their session.
CORS_ALLOW_ORIGINS=

# ==========================================
# FLINK PIPELINE DEFAULTS
# ==========================================
# Default resources per Flink TaskManager (each TM = one parallelism unit)
FLINK_TASKMANAGER_CPU=1.5          # CPU cores per TaskManager (default: 1.5)
FLINK_TASKMANAGER_MEMORY_GB=2      # Memory per TaskManager pod in GB (JVM + Python)

# PyFlink TaskManager JVM/pod memory split (K8s / CMF). The configured MEMORY_GB is the
# pod limit. Process mode prefers PROCESS_NATIVE_HEADROOM_MIN_MB outside process.size for
# Python workers; if that does not fit, headroom is compressed inside the configured total
# (pod is not grown). Thread mode uses NATIVE_HEADROOM_MIN_MB (Python shares the JVM).
FLINK_TASKMANAGER_PROCESS_MEMORY_BASE_MB=1536
FLINK_TASKMANAGER_PROCESS_MEMORY_GROWTH_FRACTION=0.1
FLINK_TASKMANAGER_PROCESS_MEMORY_MIN_MB=1280
FLINK_TASKMANAGER_PROCESS_NATIVE_HEADROOM_MIN_MB=1536
FLINK_TASKMANAGER_NATIVE_HEADROOM_MIN_MB=512

# Matcher runtime switches (rendered into FlinkDeployment + companion memory knobs).
# Matrix lives in apps/providers/matcher_runtime_tuning.py — edit that file to change
# managed.fraction / jvm-overhead / incremental / network companions.
# Restart the backend after changing these (Jinja is cached in-process), then recreate
# / update pipelines so the FlinkDeployment is re-rendered.
MATCHER_PYTHON_EXECUTION_MODE=process
MATCHER_STATE_BACKEND=rocksdb

# JobManager resources
FLINK_JOBMANAGER_CPU=1.0
FLINK_JOBMANAGER_MEMORY_GB=2

# ==========================================
# AUTOSCALER QUOTAS (Per-Pipeline Limits)
# ==========================================
# Optional: Override per-pipeline autoscaler limits
# If not set, auto-calculated from TaskManager resources
# AUTOSCALER_QUOTA_CPU=3.0
# AUTOSCALER_QUOTA_MEMORY_GB=4

# ==========================================
# FLINK PROVIDER
# ==========================================
# Provider selection: "kubernetes" (Flink Operator) or "cmf" (Confluent Manager)
FLINK_PROVIDER=kubernetes

# ==========================================
# KUBERNETES CONNECTION (when FLINK_PROVIDER=kubernetes)
# ==========================================
KUBERNETES_NAMESPACE=security
FLINK_IMAGE=flink-sigma-detector:latest
IMAGE_PULL_POLICY=Never
FLINK_IMAGE_CMF=flink-sigma-detector:latest

# Flink pod scheduling (nodeSelector for sigma-detector pipelines)
FLINK_NODE_SELECTOR_KEY=app
FLINK_NODE_SELECTOR_VALUE=detectflow-prod

# Shared ConfigMap / Secret mounted by all Flink deployments (envFrom)
FLINK_CONFIG_CONFIGMAP_NAME=flink-config
FLINK_SIGMA_CONFIG_SECRET_NAME=flink-sigma-config
# Checkpoint interval (seconds) for detectflow Flink jobs
DETECTFLOW_CHECKPOINT_INTERVAL_SEC=60

# Correlation job FlinkDeployment
CORRELATION_JOB_DEPLOYMENT_NAME=correlation-job
CORRELATION_JOB_IMAGE=detectflow-correlation-job:latest
# Number of TaskManagers (= parallelism) for the correlation job
CORRELATION_JOB_PARALLELISM=1
# Process-mode PyFlink (Beam/gRPC) + RocksDB needs 2-4 cores per slot and extra
# process memory so the off-heap Python worker has headroom for checkpoints.
CORRELATION_JOB_TASKMANAGER_MEMORY=4g
CORRELATION_JOB_TASKMANAGER_CPU=3.0
CORRELATION_JOB_JOBMANAGER_MEMORY=2g
CORRELATION_JOB_JOBMANAGER_CPU=1.0
# Input topic wired into the correlation-job container (matches KAFKA_TAGGED_EVENTS_TOPIC)
CORRELATION_JOB_INPUT_TOPIC=detectflow.tagged-events

# Agent job (LLM enrichment) FlinkDeployment
AGENT_JOB_DEPLOYMENT_NAME=agent-job
AGENT_JOB_IMAGE=detectflow-agent-job:latest
# Number of TaskManagers (= parallelism) for the agent job
AGENT_JOB_PARALLELISM=1
AGENT_JOB_TASKMANAGER_MEMORY=3g
AGENT_JOB_TASKMANAGER_CPU=1.0
AGENT_JOB_JOBMANAGER_MEMORY=2g
AGENT_JOB_JOBMANAGER_CPU=1.0
# Optional dedicated nodeSelector for the agent job (defaults inherit FLINK_NODE_SELECTOR_*)
# AGENT_NODE_SELECTOR_KEY=app
# AGENT_NODE_SELECTOR_VALUE=detectflow-agent
# LLM config (envFrom) — mounted by agent-job only
DETECTFLOW_AGENT_CONFIGMAP_NAME=detectflow-agent-config
DETECTFLOW_AGENT_SECRET_NAME=detectflow-agent-secrets
# Private-CA bundle for an LLM endpoint with a self-signed / internal certificate.
# Normally left unset: the path is read from SSL_CERT_FILE in the agent ConfigMap
# above. Set it only to override that path. Wherever it comes from, agent-job pods
# mount DETECTFLOW_AGENT_SECRET_NAME key `basename(path)` at `dirname(path)`
# (the Secret must carry the PEM under that exact key, e.g. `ca.pem`).
# DETECTFLOW_AGENT_SSL_CERT_FILE=/etc/ssl/agent-ca/ca.pem
# Path assumed when that ConfigMap cannot be read (the backend is usually not
# granted `get configmaps` in the Flink namespace). The key is then projected
# optionally and SSL_CERT_FILE is left to the ConfigMap, so a deployment without
# a private CA is unaffected. Empty disables the fallback.
# DETECTFLOW_AGENT_SSL_CERT_FILE_DEFAULT=/etc/ssl/agent-ca/ca.pem

# ==========================================
# CMF CONNECTION (when FLINK_PROVIDER=cmf)
# ==========================================
# CMF API URL (required for CMF provider)
# CMF_URL=http://cmf-service.confluent:80
# CMF environment name (required for CMF provider)
# CMF_ENVIRONMENT=default
# Kubernetes namespace where CMF deploys Flink apps (required for CMF provider)
# CMF_NAMESPACE=confluent

# CMF mTLS authentication (optional, for external access)
# CMF_CLIENT_CERT_PATH=/path/to/client.crt
# CMF_CLIENT_KEY_PATH=/path/to/client.key
# CMF_CA_CERT_PATH=/path/to/ca.crt

# Flink metrics polling interval (seconds)
FLINK_METRICS_POLL_INTERVAL=5.0

# ==========================================
# RESOURCE MANAGEMENT
# ==========================================
# IMPORTANT: Cluster-wide resource limits are managed via Kubernetes ResourceQuota
# NOT via application-level config. See k8s/resource-quota.yaml
#
# To configure cluster capacity:
# 1. Edit k8s/resource-quota.yaml with your cluster's available resources
# 2. Apply: kubectl apply -f k8s/resource-quota.yaml
# 3. View usage: kubectl describe resourcequota -n security
#
# Example ResourceQuota for 8 cores, 12 GB cluster:
#   requests.cpu: "6"       # 8 total - 2 reserved for system
#   requests.memory: "8Gi"  # 12 total - 4 reserved for system

# ==========================================
# DATABASE
# ==========================================
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/admin_panel

# ==========================================
# KAFKA CONFIGURATION
# ==========================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_AUTH_METHOD=PLAINTEXT
# Disable SSL hostname verification (for self-signed certs)
KAFKA_SSL_CHECK_HOSTNAME=false

# For SASL auth:
# KAFKA_AUTH_METHOD=SASL
# KAFKA_API_KEY=your-api-key
# KAFKA_API_SECRET=your-api-secret
# For SSL auth:
# KAFKA_AUTH_METHOD=SSL
# KAFKA_SSL_CA_LOCATION=/path/to/ca.pem
# KAFKA_SSL_CERTIFICATE_LOCATION=/path/to/cert.pem
# KAFKA_SSL_KEY_LOCATION=/path/to/key.pem

# Kafka topics
KAFKA_SIGMA_RULES_TOPIC=detectflow.sigma-rules
KAFKA_ACTIVE_THREATS_TOPIC=detectflow.active-threats
KAFKA_HOS_RULES_TOPIC=detectflow.hos-rules
KAFKA_TAGGED_EVENTS_TOPIC=detectflow.tagged-events
KAFKA_METRICS_TOPIC=detectflow.rule-metrics
KAFKA_METRICS_CONSUMER_GROUP=admin-panel-metrics
# Detectflow correlation config broadcast (compacted topic, single key ``global``)
# KAFKA_CHAINS_CONFIG_TOPIC=detectflow.chains-config
# Detectflow raw chains (correlation-job → agent-job, key=chain_id)
# KAFKA_CHAINS_RAW_TOPIC=detectflow.chains-raw
# Detectflow enriched attack chains (LLM fields; consumer upserts attack_chains)
# KAFKA_CHAINS_ANALYSED_TOPIC=detectflow.chains-analysed
# KAFKA_CHAINS_ANALYSED_CONSUMER_GROUP=admin-panel-chains-analysed
# KAFKA_CHAINS_ANALYSED_ENABLED=true
# KAFKA_CHAINS_ANALYSED_AUTO_OFFSET_RESET=earliest
# Poison-record policy for chains-analysed: a record that can never apply is retried, then parked
# in chains_analysed_dead_letters and skipped, so it cannot hold its partition for every customer.
# Attempts on ONE record before it is parked (deferrable errors only; permanent parks immediately)
# KAFKA_CHAINS_ANALYSED_MAX_ATTEMPTS=5
# Exponential retry backoff between attempts on one record (seconds)
# KAFKA_CHAINS_ANALYSED_RETRY_BACKOFF_BASE_SECONDS=0.5
# KAFKA_CHAINS_ANALYSED_RETRY_BACKOFF_MAX_SECONDS=30.0
# Wall-clock ceiling on retrying one record; also the grace before an infra stall reports unhealthy
# KAFKA_CHAINS_ANALYSED_RETRY_DEADLINE_SECONDS=120.0
# Cap on the parked payload stored per record (bytes, 256 KiB)
# KAFKA_CHAINS_ANALYSED_DEAD_LETTER_MAX_PAYLOAD_BYTES=262144
# How long parked records are kept before the periodic cleanup prunes them (days)
# KAFKA_CHAINS_ANALYSED_DEAD_LETTER_RETENTION_DAYS=30
# Poll-loop liveness bound for /health (NOT message age — chains are rare by design)
# KAFKA_CHAINS_ANALYSED_POLL_STALE_SECONDS=60
# One consumer, one regex subscription over detectflow.chains-analysed.<correlation_pipeline_id>:
# a new correlation pipeline needs no API restart. Set false to fall back to the literal topic.
# KAFKA_CHAINS_ANALYSED_TOPIC_PATTERN_ENABLED=true
# Keep consuming (and health-checking) the pre-epic singleton topic during the migration window
# KAFKA_CHAINS_ANALYSED_INCLUDE_LEGACY_TOPIC=true
# Topic-discovery bound for the pattern subscription; the only consumer that deviates from
# aiokafka's 300s default, because each refresh refetches FULL-cluster metadata (floor 30000)
# KAFKA_CHAINS_ANALYSED_METADATA_MAX_AGE_MS=60000
# Default partitions and replication for new topics (used by entrypoint.sh)
KAFKA_DEFAULT_PARTITIONS=1
KAFKA_DEFAULT_REPLICATION_FACTOR=2
# Partition count for the tagged-events tech topic (sized for correlation-job parallel consume)
KAFKA_TAGGED_EVENTS_PARTITIONS=12
# Per-detection-pipeline tagged-events topic partitions (detectflow.tagged-events.<pipeline_id>).
# 6 is MORE headroom than before, not less: the shared 12-partition topic carried every pipeline's
# traffic, and a correlation pipeline consumes the sum over its member topics.
# KAFKA_PIPELINE_TAGGED_EVENTS_PARTITIONS=6
# Per-correlation-pipeline chains-raw / chains-analysed partitions (chains-config is always 1).
# KAFKA_CORRELATION_CHAINS_PARTITIONS=3
# What happens to a per-entity topic when its owning row is deleted:
#   keep   — leave the topic untouched (external archival / strict retention regimes)
#   retire — set cleanup.policy=delete + retention.ms=<retire window>, let the broker age it out
#   delete — immediate AdminClient.delete_topics (irreversible)
# KAFKA_TOPIC_DELETE_POLICY=retire
# Grace window (ms) a retired topic stays readable before the broker reclaims it (24h)
# KAFKA_RETIRED_TOPIC_RETENTION_MS=86400000
# Bound on the pre-delete drain wait for a chains-analysed topic
# KAFKA_TOPIC_DELETE_DRAIN_TIMEOUT_SECONDS=30

# ==========================================
# DASHBOARD SETTINGS
# ==========================================
# SSE broadcast interval (seconds). Shared by the detection dashboard stream and the
# platform-wide correlation graph (`GET /api/v1/correlation_dashboard/stream`).
DASHBOARD_BROADCAST_INTERVAL_SECONDS=2.0
# TTL (seconds) for the dashboard's cached DB topology (topics/repos/rule counts/pipelines).
# SSE ticks within the TTL reuse the snapshot and run no DB queries; pipeline CRUD invalidates
# it immediately, repository/rule sync changes appear within this bound.
DASHBOARD_TOPOLOGY_TTL_SECONDS=30.0
# Concurrent Kubernetes reads when observing many correlation-pipeline runtimes
# (never one API-server call per pipeline).
CORRELATION_DASHBOARD_K8S_CONCURRENCY=4
ATTACK_CHAINS_LIST_SSE_HEARTBEAT_SECONDS=10.0

# ==========================================
# JWT AUTHENTICATION
# ==========================================
# IMPORTANT: Change these in production!
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_REFRESH_SECRET_KEY=your-refresh-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ==========================================
# AUDIT LOGS
# ==========================================
# Retention period for audit logs (days)
AUDIT_LOGS_RETENTION_DAYS=30

# ==========================================
# TDM / SOC PRIME
# ==========================================
# TDM REST API base URL (scheme + host, no path suffix). Used by SocPrimeTdmProvider for all HTTP calls.
# Default matches production SOC Prime TDM; override for proxies or non-standard deployments.
# TDM_API_BASE_URL=https://api.tdm.socprime.com
#
# SOC Prime web UI hostname (repository source links in the admin UI only; not the REST API host).
TDM_HOSTNAME=tdm.socprime.com
#
# Threat Detection Marketplace integration profile stores only the TDM API key (socprime_tdm).

# ==========================================
# ACTIVITY TRACKING
# ==========================================
KAFKA_ACTIVITY_TOPIC=detectflow.activity
KAFKA_ACTIVITY_CONSUMER_GROUP=admin-panel-activity

# ==========================================
# AUTO SYNC (Optional)
# ==========================================
# Enable automatic scheduled sync of repositories
ENABLE_AUTO_SYNC=false
SYNC_API_REPOS_INTERVAL_MINUTES=5
SYNC_API_REPOS_TIMEOUT_SECONDS=600
SYNC_ACTIVE_THREATS_ENABLED=true
SYNC_ACTIVE_THREATS_INTERVAL_MINUTES=10
SYNC_ACTIVE_THREATS_TIMEOUT_SECONDS=600
# Interval (hours) for the scheduled full (non-incremental) Active Threat/HOS/rule re-sync.
SYNC_ACTIVE_THREATS_FULL_REFRESH_INTERVAL_HOURS=6
# Active Threat retention cleanup is disabled when <= 0. Set to N days to restore age-based deletion.
SYNC_ACTIVE_THREATS_RETENTION_DAYS=-1
# Legacy Active Threat/HOS/system-rule sync delete behavior is disabled by default.
# Set these to true only if local rows should be removed when TDM no longer references them.
SYNC_DELETE_AT_MISSING_IN_TDM=false
SYNC_DELETE_ORPHAN_HOS=false
SYNC_DELETE_UNREFERENCED_SYSTEM_RULES=false

# Scheduled health check (check_all) interval when scheduler is running (minutes)
HEALTH_CHECK_INTERVAL_MINUTES=5

# ==========================================
# RULE VERSIONING
# ==========================================
# Number of content versions to keep per rule (older versions are pruned)
RULE_VERSION_RETENTION=10
# When true, hide Sigma rule ``body`` in all HTTP API responses except for rules in
# ``local`` repositories and ``external`` repositories (opensource GitHub catalog:
# SigmaHQ, Splunk, Elastic, Azure Sentinel). Bodies for ``api`` (TDM), ``gitlab``,
# and system repos are returned empty. Kafka / Flink sync is unaffected.
HIDE_RESTRICTED_RULE_BODIES=false

FLINK_CHECKPOINTS_PVC=my-checkpoints-pvc
FLINK_HA_PVC=my-ha-pvc
FLINK_SAVEPOINTS_PVC=my-savepoints-pvc
# Seconds to watch the state-cleanup Job before reporting `timed_out` (never fatal)
FLINK_CLEANUP_JOB_TIMEOUT_SECONDS=120
